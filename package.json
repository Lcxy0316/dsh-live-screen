{
  "name": "dsh-live-screen",
  "version": "0.2.2",
  "description": "Isolated window workspaces for the local Windows desktop in DeepSeek Harness: per-window capture, background injection with foreground fallback, control lease arbitration, and a live preview panel.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/host.js",
    "lib/lease.js",
    "lib/workspace.js",
    "lib/ws.js",
    "native/DesktopHost.cs",
    "native/Probe.cs",
    "scripts/*.mjs",
    "scripts/build-native.ps1",
    "cordis.patch.yml",
    "docs/panel.png",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:native": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-native.ps1",
    "test": "node scripts/verify-workspace.mjs && node scripts/verify-host.mjs && node scripts/verify-client.mjs",
    "test:ui": "node scripts/verify-ui.mjs",
    "probe": "node scripts/probe-host.mjs",
    "push:api": "node scripts/push-api.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lcxy0316/dsh-live-screen.git"
  },
  "bugs": {
    "url": "https://github.com/Lcxy0316/dsh-live-screen/issues"
  },
  "homepage": "https://github.com/Lcxy0316/dsh-live-screen#readme",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "screen-capture",
    "computer-use",
    "gui-agent",
    "window-workspace",
    "windows"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "os": [
    "win32"
  ],
  "license": "MIT"
}
